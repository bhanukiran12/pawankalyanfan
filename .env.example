# Neon PostgreSQL
# Get both URLs from: https://console.neon.tech → your project → Connection Details
#
# Pooled (recommended for app / serverless):
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
#
# Direct (recommended for Prisma migrate / db push):
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

JWT_SECRET="generate-a-strong-secret-here"
NEXTAUTH_SECRET="generate-a-strong-secret-here"
NEXTAUTH_URL="http://localhost:3000"

AUTH_SERVICE_URL="http://localhost:4001"
CONTENT_SERVICE_URL="http://localhost:4002"
COMMUNITY_SERVICE_URL="http://localhost:4003"
BILLING_SERVICE_URL="http://localhost:4004"
AI_SERVICE_URL="http://localhost:4005"
CHARITY_SERVICE_URL="http://localhost:4006"

# Jana Seva email OTP (Resend: https://resend.com)
# 1) Create API key at resend.com/api-keys
# 2) Verify your domain at resend.com/domains (e.g. pawankalyanfan.com)
# 3) Set FROM to an address on that domain (required for production)
# RESEND_API_KEY="re_xxxxxxxx"
# RESEND_FROM_EMAIL="Jana Seva <admin@pawankalyanfan.com>"
# Local dev without email: leave keys empty OR set JANA_SEVA_OTP_DEV_FALLBACK=true (shows OTP on screen)
# JANA_SEVA_OTP_DEV_FALLBACK="true"
# Or SMTP backup (e.g. Titan):
# SMTP_HOST="smtp.titan.email"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="admin@pawankalyanfan.com"
# SMTP_PASSWORD=""
# SMTP_FROM="Jana Seva <admin@pawankalyanfan.com>"
# Do NOT set NODE_ENV=production for local npm run dev:local

# Local dev (Next.js on :3000 proxies /api → gateway on :4000)
# Use /api in the browser; keep API_GATEWAY_URL for the server-side proxy.
NEXT_PUBLIC_API_URL="/api"
API_GATEWAY_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Render / production (set in dashboard; blueprint sets most automatically)
# NEXT_PUBLIC_API_URL="/api"
# API_GATEWAY_HOST="pawankalyanfan-api.onrender.com"
# NEXT_PUBLIC_SITE_URL="https://pawankalyanfan-web.onrender.com"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

OPENROUTER_API_KEY=""

ADMIN_EMAIL="admin@pawankalyanfan.com"
ADMIN_PASSWORD="admin123"

# Web Push (Jana Sena news + Jana Seva volunteer help alerts)
# Generate keys: node scripts/generate-vapid-keys.mjs
# Production (Render): set all four vars on the pawankalyanfan service, then redeploy.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must match VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@pawankalyanfan.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
