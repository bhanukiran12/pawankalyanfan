generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventType {
  MOVIE_RELEASE
  SPEECH
  POLITICAL
  PUBLIC_APPEARANCE
  AWARD
  OTHER
}

enum QuoteCategory {
  MOTIVATIONAL
  POLITICAL
  MOVIE_DIALOGUE
  DEVOTIONAL
  LEADERSHIP
}

enum SpeechTag {
  POLITICAL
  MOVIE
  PUBLIC_EVENT
  INTERVIEW
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  isPremium     Boolean   @default(false)
  premiumBadge  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  membership        Membership?
  favoriteQuotes    FavoriteQuote[]
  favoriteWallpapers FavoriteWallpaper[]
  forumThreads      ForumThread[]
  forumReplies      ForumReply[]
  forumLikes        ForumLike[]
  fanSubmissions    FanSubmission[]
  submissionLikes   SubmissionLike[]
  submissionComments SubmissionComment[]
  reports           Report[]
  affiliateClicks   AffiliateClick[]
  notifications     Notification[]
  charityProfile    CharityProfile?
  bloodRequests     BloodRequest[]
  bloodCamps        BloodCamp[]
  workshops         Workshop[]
  scholarships      Scholarship[]
  emergencyPosts    EmergencyPost[]
  charityReports    CharityAbuseReport[]
  savedCharityItems SavedCharityItem[]
  charityAuditLogs  CharityAuditLog[]
  janaSevaStories   JanaSevaSuccessStory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id                 String           @id @default(cuid())
  userId             String           @unique
  status             MembershipStatus @default(PENDING)
  razorpaySubId      String?
  razorpayCustomerId String?
  planAmount         Int              @default(9900)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Movie {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  releaseDate DateTime
  posterUrl   String?
  bannerUrl   String?
  synopsis    String   @db.Text
  genre       String[]
  rating      Float    @default(0)
  trivia      String?  @db.Text
  trailerUrl  String?
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cast      MovieCast[]
  dialogues MovieDialogue[]
  songs     MovieSong[]
  gallery   MovieGallery[]
  events    TimelineEvent[]
}

model MovieCast {
  id       String @id @default(cuid())
  movieId  String
  name     String
  role     String
  imageUrl String?

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model MovieDialogue {
  id      String @id @default(cuid())
  movieId String
  text    String @db.Text
  context String?

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model MovieSong {
  id       String  @id @default(cuid())
  movieId  String
  title    String
  singer   String?
  videoUrl String?

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model MovieGallery {
  id       String @id @default(cuid())
  movieId  String
  imageUrl String
  caption  String?

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model Speech {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  date        DateTime
  event       String
  transcript  String      @db.Text
  summary     String      @db.Text
  highlights  String[]
  videoUrl    String?
  thumbnailUrl String?
  tags        SpeechTag[]
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  viewCount   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  quotes Quote[]
  events TimelineEvent[]
}

model Quote {
  id         String        @id @default(cuid())
  text       String        @db.Text
  slug       String        @unique
  category   QuoteCategory
  source     String?
  speechId   String?
  movieTitle String?
  imageUrl   String?
  isPremium  Boolean       @default(false)
  featured   Boolean       @default(false)
  shareCount Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  speech   Speech?         @relation(fields: [speechId], references: [id], onDelete: SetNull)
  favorites FavoriteQuote[]
}

model FavoriteQuote {
  id        String   @id @default(cuid())
  userId    String
  quoteId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([userId, quoteId])
}

model Wallpaper {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  imageUrl    String
  thumbnailUrl String?
  tags        String[]
  isPremium   Boolean  @default(false)
  downloadCount Int    @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites FavoriteWallpaper[]
}

model FavoriteWallpaper {
  id          String   @id @default(cuid())
  userId      String
  wallpaperId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallpaper Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)

  @@unique([userId, wallpaperId])
}

model FanSubmission {
  id          String           @id @default(cuid())
  userId      String
  title       String
  description String?          @db.Text
  mediaUrl    String
  mediaType   String           @default("image")
  status      SubmissionStatus @default(PENDING)
  likeCount   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    SubmissionLike[]
  comments SubmissionComment[]
}

model SubmissionLike {
  id           String   @id @default(cuid())
  userId       String
  submissionId String
  createdAt    DateTime @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission FanSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, submissionId])
}

model SubmissionComment {
  id           String   @id @default(cuid())
  userId       String
  submissionId String
  content      String   @db.Text
  createdAt    DateTime @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission FanSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.Text
  coverImage  String?
  category    String
  tags        String[]
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  trending    Boolean  @default(false)
  viewCount   Int      @default(0)
  authorName  String   @default("Editorial Team")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TimelineEvent {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  date        DateTime
  type        EventType
  imageUrl    String?
  movieId     String?
  speechId    String?
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  movie  Movie?  @relation(fields: [movieId], references: [id], onDelete: SetNull)
  speech Speech? @relation(fields: [speechId], references: [id], onDelete: SetNull)
}

model ForumCategory {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String?
  icon        String?
  sortOrder   Int    @default(0)

  threads ForumThread[]
}

model ForumThread {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String   @db.Text
  categoryId String
  userId     String
  isPinned   Boolean  @default(false)
  isLocked   Boolean  @default(false)
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ForumCategory @relation(fields: [categoryId], references: [id])
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies  ForumReply[]
  likes    ForumLike[]
  reports  Report[]
}

model ForumReply {
  id        String   @id @default(cuid())
  content   String   @db.Text
  threadId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ForumLike {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
}

model Report {
  id        String   @id @default(cuid())
  reason    String
  threadId  String?
  userId    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  thread ForumThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AffiliateProduct {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  imageUrl     String?
  affiliateUrl String
  category     String
  commission   Float    @default(0)
  clickCount   Int      @default(0)
  conversions  Int      @default(0)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clicks AffiliateClick[]
}

model AffiliateClick {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  ipAddress String?
  userAgent String?
  converted Boolean  @default(false)
  createdAt DateTime @default(now())

  product AffiliateProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AdPlacement {
  id        String  @id @default(cuid())
  name      String  @unique
  slot      String
  enabled   Boolean @default(true)
  adCode    String? @db.Text
  sortOrder Int     @default(0)
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("info")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  path      String?
  userId    String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())
}

model AiPrompt {
  id        String   @id @default(cuid())
  name      String   @unique
  system    String   @db.Text
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ─── Jana Seva (verified community help) ───────────────────

enum CharityVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BloodUrgency {
  NORMAL
  URGENT
  CRITICAL
}

enum CharityListingStatus {
  OPEN
  FULFILLED
  EXPIRED
  CLOSED
  REJECTED
}

enum WorkshopMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum EmergencyCategory {
  AMBULANCE
  MEDICINE
  TRANSPORT
  OXYGEN
  URGENT_ASSISTANCE
}

enum VolunteerTier {
  BRONZE
  SILVER
  GOLD
  HERO
  LEGEND
}

enum CharityItemType {
  BLOOD_REQUEST
  BLOOD_CAMP
  WORKSHOP
  SCHOLARSHIP
  EMERGENCY
  SUCCESS_STORY
}

enum JanaSevaSevaType {
  BLOOD
  BLOOD_CAMP
  WORKSHOP
  SCHOLARSHIP
  EMERGENCY
  EDUCATION
  OTHER
}

model JanaSevaEmailOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model JanaSevaPostSession {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CharityProfile {
  id                  String        @id @default(cuid())
  userId              String?       @unique
  displayName         String
  contactEmail        String?
  city                String
  state               String
  skills              String[]      @default([])
  isBloodDonor        Boolean       @default(false)
  isWorkshopMentor    Boolean       @default(false)
  isEventVolunteer    Boolean       @default(false)
  offersTransport     Boolean       @default(false)
  isEmergencyResponder Boolean      @default(false)
  availability        String?       @db.Text
  profileImage        String?
  phone               String?
  verificationStatus  CharityVerificationStatus @default(VERIFIED)
  contributionScore   Int           @default(0)
  tier                VolunteerTier @default(BRONZE)
  verifiedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  volunteerAlert JanaSevaVolunteerAlert?
}

// Volunteer email + browser alerts when new help is posted
model JanaSevaVolunteerAlert {
  id                 String   @id @default(cuid())
  email              String   @unique
  charityProfileId   String?  @unique
  city               String?
  state              String?
  emailAlertsEnabled Boolean  @default(true)
  pushAlertsEnabled  Boolean  @default(true)
  notifyBlood        Boolean  @default(true)
  notifyEmergency    Boolean  @default(true)
  notifyCamps        Boolean  @default(true)
  notifyEducation    Boolean  @default(true)
  pushEndpoint       String?  @unique
  pushP256dh         String?
  pushAuth           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  charityProfile CharityProfile? @relation(fields: [charityProfileId], references: [id], onDelete: Cascade)
}

model BloodRequest {
  id                 String                    @id @default(cuid())
  slug               String                    @unique
  patientName        String?
  patientAge         Int?
  hospitalName       String
  hospitalAddress    String
  city               String
  state              String
  bloodGroup         String
  unitsRequired      Int                       @default(1)
  urgency            BloodUrgency              @default(NORMAL)
  doctorNoteUrl      String?
  phone              String
  alternatePhone     String?
  whatsapp           String?
  expiresAt          DateTime
  anonymous          Boolean                   @default(false)
  consentGiven       Boolean                   @default(true)
  verificationStatus CharityVerificationStatus @default(PENDING)
  status             CharityListingStatus      @default(OPEN)
  fulfilledAt        DateTime?
  userId             String?
  latitude           Float?
  longitude          Float?
  viewCount          Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user    User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  reports CharityAbuseReport[]
}

model BloodCamp {
  id                 String                    @id @default(cuid())
  slug               String                    @unique
  title              String
  organizerName      String
  organization       String?
  address            String
  city               String
  state              String
  latitude           Float?
  longitude          Float?
  campDate           DateTime
  campTime           String
  phone              String
  registrationUrl    String?
  description        String                    @db.Text
  posterUrl          String?
  verificationStatus CharityVerificationStatus @default(PENDING)
  status             CharityListingStatus      @default(OPEN)
  rsvpCount          Int                       @default(0)
  userId             String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Workshop {
  id                 String                    @id @default(cuid())
  slug               String                    @unique
  title              String
  speaker            String
  organization       String?
  category           String
  mode               WorkshopMode              @default(ONLINE)
  city               String?
  workshopDate       DateTime
  workshopTime       String
  capacity           Int?
  registrationUrl    String?
  whatsappGroupUrl   String?
  posterUrl          String?
  certificateAvailable Boolean                 @default(false)
  isFree             Boolean                   @default(true)
  description        String                    @db.Text
  verificationStatus CharityVerificationStatus @default(PENDING)
  status             CharityListingStatus      @default(OPEN)
  trending           Boolean                   @default(false)
  userId             String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Scholarship {
  id                 String                    @id @default(cuid())
  slug               String                    @unique
  title              String
  provider           String
  amount             String?
  eligibility        String                    @db.Text
  deadline           DateTime
  applicationUrl     String
  category           String
  documentsRequired  String?                   @db.Text
  description        String                    @db.Text
  verificationStatus CharityVerificationStatus @default(PENDING)
  status             CharityListingStatus      @default(OPEN)
  userId             String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model EmergencyPost {
  id                 String                    @id @default(cuid())
  slug               String                    @unique
  title              String
  category           EmergencyCategory
  description        String                    @db.Text
  city               String
  state              String
  phone              String
  expiresAt          DateTime
  verificationStatus CharityVerificationStatus @default(PENDING)
  status             CharityListingStatus      @default(OPEN)
  trustScore         Int                       @default(0)
  userId             String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user    User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  reports CharityAbuseReport[]
}

model CharityAbuseReport {
  id         String   @id @default(cuid())
  reason     String
  details    String?  @db.Text
  resolved   Boolean  @default(false)
  reporterId String?
  bloodRequestId String?
  emergencyPostId String?
  createdAt  DateTime @default(now())

  reporter      User?          @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  bloodRequest  BloodRequest?  @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  emergencyPost EmergencyPost? @relation(fields: [emergencyPostId], references: [id], onDelete: Cascade)
}

model SavedCharityItem {
  id        String          @id @default(cuid())
  userId    String
  itemType  CharityItemType
  itemId    String
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
}

model CharityAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  actorId    String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// Volunteer shares who they helped — caption, photos, hashtags, social share
model JanaSevaSuccessStory {
  id              String           @id @default(cuid())
  slug            String           @unique
  volunteerName   String
  contactEmail    String?
  sevaType        JanaSevaSevaType
  caption         String           @db.Text
  helpedSummary   String           @db.Text
  helpedDisplay   String
  photoUrls       String[]
  hashtags        String[]         @default([])
  city            String?
  state           String?
  consentGiven    Boolean          @default(true)
  verificationStatus CharityVerificationStatus @default(VERIFIED)
  status          CharityListingStatus @default(OPEN)
  viewCount       Int              @default(0)
  userId          String?
  verifiedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
